---
// Numéro de téléphone cliquable (tel:). Masqué si aucun numéro n'est réglé.
// Le numéro se règle dans src/data/studio.ts (TELEPHONE).
import { TELEPHONE } from '../data/studio';
interface Props {
  class?: string;
}
const { class: classe = 'lien' } = Astro.props;
---

{TELEPHONE && <a class={classe} href={`tel:${TELEPHONE.lien}`}>{TELEPHONE.affichage}</a>}
