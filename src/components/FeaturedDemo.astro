---
// Bloc « projet mis en avant » : la démo marquée enAvant dans src/data/demos.ts (à défaut, la première).
import { demos } from '../data/demos';
import { formules } from '../data/tarifs';

const d = demos.find((x) => x.enAvant) ?? demos[0];
const formule = formules.find((f) => f.slug === d?.formule)?.nom;
---

{d && (
  <article class="vedette" id="demo-en-avant" aria-labelledby="vedette-h">
    <div class="vedette__texte">
      <p class="label">Projet mis en avant</p>
      <h3 id="vedette-h" class="vedette__titre">{d.nom}</h3>
      <p class="discret">{d.description}</p>
      {formule && <p class="mono discret">{d.secteur} · Formule {formule}</p>}
      <a class="lien" href={d.url} target="_blank" rel="noopener">Voir le site <span class="fleche" aria-hidden="true">→</span><span class="cache"> (nouvel onglet)</span></a>
    </div>
    <a class="vedette__image" href={d.url} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
      <div class="capture">
        <img src={d.imagePetite} srcset={`${d.imagePetite} 720w, ${d.image} 1440w`} sizes="(min-width: 960px) 50vw, 100vw" width="1440" height="800" alt="" loading="lazy" decoding="async" />
      </div>
    </a>
  </article>
)}

<style>
  .vedette {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gout);
    row-gap: 32px;
    align-items: center;
    margin-top: clamp(40px, 6vw, 84px);
    padding-block: clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--encre);
    border-bottom: 1px solid var(--encre);
  }
  .vedette__texte {
    grid-column: 1 / span 5;
    display: grid;
    gap: 16px;
    justify-items: start;
  }
  .vedette__titre {
    font-family: var(--serif);
    font-optical-sizing: auto;
    font-weight: 340;
    font-size: clamp(2.2rem, 1.2rem + 3vw, 4rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
  }
  .vedette__texte .discret:first-of-type {
    max-width: 40ch;
  }
  .vedette__image {
    grid-column: 7 / span 6;
  }
  .vedette__image .capture {
    border-radius: 18px;
  }
  .vedette__image img {
    transition: transform 600ms var(--ease);
  }
  @media (hover: hover) and (pointer: fine) {
    .vedette__image:hover img {
      transform: scale(1.02);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vedette__image img {
      transition: none;
    }
  }
  @media (max-width: 959px) {
    .vedette__texte,
    .vedette__image {
      grid-column: 1 / -1;
    }
  }
</style>
