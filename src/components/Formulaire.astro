---
// Formulaire de contact, relié à FormSubmit (formsubmit.co) : les messages
// arrivent directement par e-mail à l'adresse de studio.email.
// Le tout premier envoi déclenche un e-mail d'activation à cliquer une seule fois.
import { formules, boutique } from '../data/tarifs';
import { studio } from '../data/studio';
---

<form
  class="form devis"
  name="contact"
  method="POST"
  action={`https://formsubmit.co/${studio.email}`}
  data-ajax={`https://formsubmit.co/ajax/${studio.email}`}
>
  <input type="hidden" name="_subject" value="Nouvelle demande depuis pykestudio.fr" />
  <input type="hidden" name="_next" value={`${studio.url}/merci`} />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_captcha" value="false" />
  <p class="piege" aria-hidden="true">
    <label>Ne pas remplir : <input name="_honey" tabindex="-1" autocomplete="off" /></label>
  </p>

  <label class="champ"><span class="label">Votre nom</span>
    <input id="devis-nom" name="nom" type="text" autocomplete="name" required />
  </label>
  <label class="champ"><span class="label">Nom du commerce et ville (facultatif)</span>
    <input name="commerce" type="text" autocomplete="organization" />
  </label>
  <label class="champ"><span class="label">E-mail</span>
    <input name="email" type="email" autocomplete="email" required />
  </label>
  <label class="champ"><span class="label">Téléphone (facultatif)</span>
    <input name="telephone" type="tel" autocomplete="tel" />
  </label>
  <label class="champ plein"><span class="label">Formule</span>
    <select id="devis-formule" name="formule">
      <option value="Je ne sais pas encore">Je ne sais pas encore</option>
      {formules.map((f) => <option value={f.nom}>{f.nom}</option>)}
      <option value={boutique.nom}>{boutique.nom}</option>
    </select>
  </label>
  <label class="champ plein"><span class="label">Votre projet</span>
    <textarea name="message" rows="4" required></textarea>
  </label>

  <div class="plein">
    <button class="bouton" type="submit">Demander un devis <span class="fleche" aria-hidden="true">→</span></button>
  </div>
  <p class="plein mono discret">
    Vos informations servent uniquement à vous répondre
    (<a class="lien" href="/mentions-legales#donnees">mentions légales</a>).
  </p>
  <p class="plein statut" role="status" aria-live="polite"></p>
</form>

<script define:vars={{ email: studio.email }}>
  // Envoi sans quitter la page (FormSubmit, réponse JSON). Sans JavaScript, le formulaire
  // est envoyé normalement à FormSubmit, qui redirige vers /merci (_next).
  const form = document.querySelector('form.devis');
  if (form) {
    const statut = form.querySelector('.statut');
    const bouton = form.querySelector('button[type=submit]');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      bouton.disabled = true;
      statut.textContent = 'Envoi en cours…';
      try {
        const rep = await fetch(form.dataset.ajax, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const json = await rep.json().catch(() => ({}));
        if (!rep.ok || String(json.success) !== 'true') throw new Error(String(rep.status));
        form.reset();
        statut.textContent = 'Merci, votre demande est bien envoyée. Nous vous répondons sous 48 h.';
      } catch {
        statut.textContent = `L’envoi n’a pas fonctionné. Réessayez, ou écrivez-nous à ${email}.`;
      } finally {
        bouton.disabled = false;
      }
    });
  }
</script>

<style>
  .statut:empty,
  .piege {
    display: none;
  }
  .statut {
    font-weight: 500;
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    @starting-style {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .statut {
      transition: opacity 200ms ease;
      transform: none;
    }
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
</style>
