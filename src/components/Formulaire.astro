---
// Formulaire de demande de devis, envoyé via Web3Forms (web3forms.com).
// - La clé d'accès est dans le fichier .env (PUBLIC_WEB3FORMS_KEY) et dans Cloudflare Pages.
//   L'adresse qui reçoit les messages est réglée sur le compte Web3Forms, pas dans le code.
// - Sans clé (ou si le service ne répond pas), on ne fait JAMAIS semblant d'avoir envoyé :
//   on ouvre l'application e-mail du visiteur avec sa demande déjà rédigée.
import { formules, boutique } from '../data/tarifs';
import { studio } from '../data/studio';

const cle = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
---

<form
  class="form devis"
  name="contact"
  method="POST"
  action={cle ? 'https://api.web3forms.com/submit' : `mailto:${studio.email}`}
  enctype={cle ? undefined : 'text/plain'}
  data-cle={cle}
>
  {cle && <input type="hidden" name="access_key" value={cle} />}
  <input type="hidden" name="subject" value="Nouvelle demande depuis pykestudio.fr" />
  <input type="hidden" name="from_name" value="Site pykestudio.fr" />
  <input type="hidden" name="redirect" value={`${studio.url}/merci`} />
  <!-- Piège à robots (honeypot Web3Forms) : case invisible, seuls les robots la cochent -->
  <p class="piege" aria-hidden="true">
    <label>Ne pas cocher : <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
  </p>

  <label class="champ"><span class="label">Votre nom</span>
    <input id="devis-nom" name="nom" type="text" autocomplete="name" required />
  </label>
  <label class="champ"><span class="label">Nom du commerce et ville (facultatif)</span>
    <input name="commerce" type="text" autocomplete="organization" />
  </label>
  <label class="champ"><span class="label">E-mail</span>
    <input name="email" type="email" autocomplete="email" required />
  </label>
  <label class="champ"><span class="label">Téléphone (facultatif)</span>
    <input name="telephone" type="tel" autocomplete="tel" />
  </label>
  <label class="champ plein"><span class="label">Formule</span>
    <select id="devis-formule" name="formule">
      <option value="Je ne sais pas encore">Je ne sais pas encore</option>
      {formules.map((f) => <option value={f.nom}>{f.nom}</option>)}
      <option value={boutique.nom}>{boutique.nom}</option>
    </select>
  </label>
  <label class="champ plein"><span class="label">Votre projet</span>
    <textarea name="message" rows="4" required></textarea>
  </label>

  <div class="plein">
    <button class="bouton" type="submit">Demander un devis <span class="fleche" aria-hidden="true">→</span></button>
  </div>
  <p class="plein mono discret">
    Vos informations servent uniquement à vous répondre
    (<a class="lien" href="/mentions-legales#donnees">mentions légales</a>).
  </p>
  <p class="plein statut" role="status" aria-live="polite"></p>
</form>

<script define:vars={{ email: studio.email }}>
  // Envoi sans quitter la page. La validation (champs requis, format de l'e-mail) est faite
  // par le navigateur avant cet événement.
  const form = document.querySelector('form.devis');
  if (form) {
    const statut = form.querySelector('.statut');
    const bouton = form.querySelector('button[type=submit]');
    const cle = form.dataset.cle || '';

    /** Plan B : ouvre l'application e-mail du visiteur avec la demande déjà rédigée. */
    const parEmail = (raison) => {
      const d = new FormData(form);
      const corps = [
        `Nom : ${d.get('nom')}`,
        `Commerce et ville : ${d.get('commerce') || '—'}`,
        `E-mail : ${d.get('email')}`,
        `Téléphone : ${d.get('telephone') || '—'}`,
        `Formule : ${d.get('formule')}`,
        '',
        String(d.get('message') || ''),
      ].join('\n');
      const sujet = encodeURIComponent(`Demande de devis – ${d.get('nom')}`);
      location.href = `mailto:${email}?subject=${sujet}&body=${encodeURIComponent(corps)}`;
      statut.replaceChildren(
        `${raison ? raison + ' ' : ''}Votre application e-mail s’ouvre avec votre demande déjà rédigée : il ne reste qu’à l’envoyer. Sinon, écrivez-nous à `,
        Object.assign(document.createElement('a'), { className: 'lien', href: `mailto:${email}`, textContent: email }),
        '.',
      );
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Piège coché = robot : on ne fait rien
      if (form.elements.namedItem('botcheck')?.checked) return;
      if (!cle) return parEmail('');
      bouton.disabled = true;
      statut.textContent = 'Envoi en cours…';
      try {
        const donnees = Object.fromEntries(new FormData(form));
        delete donnees.redirect; // utile seulement sans JavaScript
        const rep = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(donnees),
        });
        const json = await rep.json().catch(() => ({}));
        if (!rep.ok || json.success !== true) throw new Error(String(rep.status));
        form.reset();
        statut.textContent = 'Merci, votre demande est bien envoyée. Nous vous répondons sous 48 h.';
      } catch {
        parEmail('L’envoi automatique n’a pas fonctionné.');
      } finally {
        bouton.disabled = false;
      }
    });
  }
</script>

<style>
  .statut:empty,
  .piege {
    display: none;
  }
  .statut {
    font-weight: 500;
    transition:
      opacity 200ms cubic-bezier(0.23, 1, 0.32, 1),
      transform 200ms cubic-bezier(0.23, 1, 0.32, 1);
    @starting-style {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .statut {
      transition: opacity 200ms ease;
      transform: none;
    }
  }
  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }
</style>
