---
import PageSimple from '../layouts/PageSimple.astro';
import FormuleExemple from '../components/FormuleExemple.astro';
import { studio } from '../data/studio';
import {
  validite,
  formules,
  inclusPartout,
  boutique,
  options,
  maintenance,
  conditions,
  offreLancement,
  prixRemise,
  PRIX_A_COMPLETER,
  euros,
} from '../data/tarifs';
---

<PageSimple
  titre="Tarifs · Pyke Studio, création de sites web"
  h1="Tarifs détaillés"
  description="Tarifs Pyke Studio : site Essentiel 390 €, Vitrine 690 €, Vitrine+ 990 €, boutique en ligne dès 1 500 €. Maintenance 29 € par mois. TVA non applicable."
>
  <p>{validite}. Prix nets : {studio.legal.tva}.{offreLancement && ` ${offreLancement}.`}</p>

  {formules.map((f) => (
    <>
      <h2 class="tarifs-formule" id={`formule-${f.slug}`}>{f.nom}, {euros(f.prix)}{prixRemise(f.prix) !== null && <span class="accent"> · {euros(prixRemise(f.prix)!)} avec l’offre de lancement</span>}</h2>
      <p>Idéal pour : {f.ideal}</p>
      <ul>
        {f.detail.map((d) => <li>{d}</li>)}
        {inclusPartout.map((d) => <li>{d}</li>)}
      </ul>
      <div class="tarifs-exemple"><FormuleExemple slug={f.slug} /></div>
      <p><a class="lien" href={`/?formule=${f.slug}#devis`}>Choisir la formule {f.nom} <span class="fleche" aria-hidden="true">→</span></a></p>
    </>
  ))}

  <h2>{boutique.nom}, dès {euros(boutique.aPartirDe)}</h2>
  <p>Sur devis, selon le nombre de produits et les modes de paiement.</p>

  <h2>Options</h2>
  <ul class="rows" role="list">
    {options.map((o) => (
      <li><span class="rows__name">{o.nom}</span><span class="rows__value">{o.prix === null ? <span class="a-completer">{PRIX_A_COMPLETER}</span> : euros(o.prix)}</span></li>
    ))}
  </ul>

  <h2>Maintenance, {maintenance.prixMois} € par mois</h2>
  <p>Avec {maintenance.engagement}.</p>
  <ul>
    {maintenance.points.map((p) => <li>{p}</li>)}
  </ul>

  <h2>Conditions</h2>
  <ul>
    {conditions.map((c) => <li>{c}</li>)}
  </ul>

  <p>Le détail des engagements de chacun figure dans nos <a href="/cgv">conditions générales de vente</a>.</p>

  <div style="margin-top: 48px">
    <a href="/#devis" class="bouton">Demander un devis</a>
  </div>
</PageSimple>

<script>
  // ?formule=vitrine (ou essentiel, vitrine-plus) : on amène le visiteur sur la bonne formule.
  const slug = new URLSearchParams(location.search).get('formule');
  const titre = slug ? document.getElementById(`formule-${slug}`) : null;
  if (titre) {
    titre.setAttribute('data-choisie', '');
    titre.scrollIntoView({ block: 'start' });
  }
</script>
