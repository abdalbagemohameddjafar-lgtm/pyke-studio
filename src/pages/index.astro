---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Realisations from '../components/Realisations.astro';
import Formules from '../components/Formules.astro';
import Formulaire from '../components/Formulaire.astro';
import { studio } from '../data/studio';
import { boutique, maintenance, offreLancement, euros } from '../data/tarifs';
import apercu from '../assets/realisations/maison-ambre.jpg';

const metiers = [
  {
    nom: 'Fleuristes',
    texte: 'Vos compositions en photo, vos horaires et la commande en un appel.',
    icone: 'M12 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 0v14M12 14c-3 0-6-2-6-5 3 0 6 2 6 5Zm0 0c3 0 6-2 6-5-3 0-6 2-6 5Z',
  },
  {
    nom: 'Tatoueurs',
    texte: 'Un portfolio qui met vos flashs en valeur et une prise de contact simple.',
    icone: 'M4 20 15 9m-2-2 4 4m-1-7 4 4-3 3-4-4 3-3ZM4 20l1-4 3 3-4 1Z',
  },
  {
    nom: 'Restaurants',
    texte: 'La carte toujours à jour, les horaires et la réservation au bout du doigt.',
    icone: 'M7 2v9a2 2 0 0 1-2 2v9M7 2v6M4 2v6a3 3 0 0 0 3 3m3-9v6a3 3 0 0 1-3 3m10 11V2c-2 1-3 4-3 8h3',
  },
  {
    nom: 'Boutiques',
    texte: 'Vos produits, votre univers et l’envie de passer la porte du magasin.',
    icone: 'M4 7h16l-1 13H5L4 7Zm4 0a4 4 0 0 1 8 0',
  },
];

const atouts = [
  {
    titre: 'Pensé pour le mobile',
    texte: 'La plupart de vos clients vous cherchent sur leur téléphone. Votre site y est parfait.',
  },
  {
    titre: 'Trouvé sur Google',
    texte: 'Fiche Google configurée et référencement local : on vous trouve quand on cherche « près de moi ».',
  },
  {
    titre: 'En ligne en 7 à 10 jours',
    texte: 'Pas de projet qui traîne des mois. Dès réception de vos contenus, votre site est prêt rapidement.',
  },
  {
    titre: 'Un interlocuteur à Metz',
    texte: 'On se rencontre en vrai, dans votre commerce. Pas de plateforme, pas de centre d’appel.',
  },
];

const etapes = [
  {
    titre: 'On se rencontre',
    texte: 'On passe vous voir dans votre commerce pour comprendre votre activité et vos besoins. Gratuit et sans engagement.',
  },
  {
    titre: 'Devis et signature',
    texte: 'Vous recevez un devis clair, au prix affiché. 40 % d’acompte à la signature pour lancer le projet.',
  },
  {
    titre: 'Création du site',
    texte: 'Votre site est prêt sous 7 à 10 jours après réception de vos contenus. 2 séries de corrections incluses.',
  },
  {
    titre: 'Mise en ligne et suivi',
    texte: `Le solde est réglé à la mise en ligne. Avec la maintenance (${maintenance.prixMois} €/mois), on s’occupe de tout ensuite.`,
  },
];

const questions = [
  {
    q: 'Je n’ai pas de textes ni de photos, c’est un problème ?',
    r: 'Pas du tout. On peut rédiger vos textes (option à 120 €) et venir faire les photos sur place (option à 100 €).',
  },
  {
    q: 'Le nom de domaine et l’hébergement, c’est compris ?',
    r: `Oui, avec la maintenance à ${maintenance.prixMois} €/mois (engagement 12 mois) : hébergement, nom de domaine, mises à jour, sauvegardes et 30 minutes de modifications chaque mois.`,
  },
  {
    q: 'Je pourrai changer mes horaires ou mes prix ?',
    r: 'Oui. Envoyez-nous un message : les petites modifications (horaires, photos, prix…) sont comprises dans les 30 minutes mensuelles de la maintenance.',
  },
  {
    q: 'Vous intervenez où ?',
    r: 'À Metz et dans ses alentours, pour pouvoir vous rencontrer en personne. Pour les projets plus éloignés, on peut aussi travailler à distance.',
  },
  {
    q: 'Faut-il payer la TVA en plus ?',
    r: 'Non. Pyke Studio est une micro-entreprise : TVA non applicable (art. 293 B du CGI). Les prix affichés sont les prix que vous payez.',
  },
];
---

<Layout>
  <!-- ========== Accueil ========== -->
  <section class="hero">
    <div class="conteneur hero-in">
      <div class="hero-texte">
        <p class="pastille"><span></span>{offreLancement}</p>
        <h1>Un site web qui donne envie de <em>pousser votre porte</em>.</h1>
        <p class="hero-intro">
          Pyke Studio crée des sites simples, rapides et soignés pour les artisans et commerçants de
          Metz et alentours : fleuristes, tatoueurs, restaurants, boutiques… On se rencontre en vrai,
          et on s’occupe de tout.
        </p>
        <div class="hero-actions">
          <a href="#contact" class="bouton bouton-plein">Demander un devis gratuit</a>
          <a href="#offres" class="bouton bouton-contour">Voir les offres</a>
        </div>
        <ul class="hero-preuves" role="list">
          <li><strong>dès 390 €</strong> sans TVA</li>
          <li><strong>7 à 10 jours</strong> pour être en ligne</li>
          <li><strong>100 %</strong> adapté mobile</li>
        </ul>
      </div>

      <div class="hero-visuel" aria-hidden="true">
        <div class="navigateur">
          <div class="navigateur-barre"><i></i><i></i><i></i><span>votre-commerce.fr</span></div>
          <Image src={apercu} alt="" widths={[600, 900]} sizes="(min-width: 900px) 520px, 90vw" loading="eager" />
        </div>
        <div class="telephone">
          <div class="telephone-ecran">
            <span class="tel-logo"></span>
            <span class="tel-ligne l1"></span>
            <span class="tel-ligne l2"></span>
            <span class="tel-bouton">Appeler</span>
            <span class="tel-carte"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== Pour qui ========== -->
  <section class="section" aria-labelledby="titre-pourqui">
    <div class="conteneur">
      <div class="entete-section">
        <span class="surtitre">Pour qui ?</span>
        <h2 class="titre-section" id="titre-pourqui">Les commerces de quartier qui méritent d’être vus.</h2>
        <p class="intro-section">
          Vos clients vous cherchent sur Google avant de se déplacer. Sans site, ils tombent sur
          le voisin. Avec Pyke Studio, vous avez enfin une vitrine en ligne à votre image.
        </p>
      </div>
      <ul class="metiers" role="list">
        {
          metiers.map((m) => (
            <li class="metier">
              <span class="metier-icone">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={m.icone} />
                </svg>
              </span>
              <h3>{m.nom}</h3>
              <p>{m.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ========== Atouts ========== -->
  <section class="section section-sombre" aria-labelledby="titre-atouts">
    <div class="conteneur">
      <div class="entete-section">
        <span class="surtitre">Ce que vous obtenez</span>
        <h2 class="titre-section" id="titre-atouts">Un vrai site professionnel, sans prise de tête.</h2>
      </div>
      <ol class="atouts" role="list">
        {
          atouts.map((a, i) => (
            <li class="atout">
              <span class="atout-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{a.titre}</h3>
              <p>{a.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ========== Réalisations ========== -->
  <section class="section section-fond" id="realisations" aria-labelledby="titre-real">
    <div class="conteneur">
      <div class="entete-section">
        <span class="surtitre">Réalisations</span>
        <h2 class="titre-section" id="titre-real">Nos derniers sites.</h2>
        <p class="intro-section">
          Des sites de démonstration pour vous montrer ce qu’on sait faire, et bientôt ceux de nos
          premiers clients. Cliquez pour les visiter.
        </p>
      </div>
      <Realisations />
    </div>
  </section>

  <!-- ========== Offres ========== -->
  <section class="section" id="offres" aria-labelledby="titre-offres">
    <div class="conteneur">
      <div class="entete-section centre">
        <span class="surtitre">Offres</span>
        <h2 class="titre-section" id="titre-offres">Des prix clairs, affichés, sans surprise.</h2>
        <p class="intro-section">Prix nets : TVA non applicable. Vous payez exactement ce qui est écrit.</p>
      </div>

      <Formules />

      <p class="boutique-ligne">
        <strong>{boutique.nom}</strong> : sur devis, à partir de {euros(boutique.aPartirDe)}.
      </p>

      <div class="maintenance">
        <div class="maintenance-prix">
          <span class="surtitre">Maintenance</span>
          <p><strong>{maintenance.prixMois} €</strong> / mois</p>
          <small>{maintenance.engagement}</small>
        </div>
        <ul>
          {maintenance.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>

      <div class="offres-bas">
        <p class="lancement">{offreLancement}</p>
        <a href="/tarifs" class="lien-fleche">Options, maintenance et conditions en détail <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- ========== Méthode ========== -->
  <section class="section section-fond" id="methode" aria-labelledby="titre-methode">
    <div class="conteneur">
      <div class="entete-section">
        <span class="surtitre">Méthode</span>
        <h2 class="titre-section" id="titre-methode">De la première rencontre à la mise en ligne.</h2>
      </div>
      <ol class="etapes" role="list">
        {
          etapes.map((e, i) => (
            <li class="etape">
              <span class="etape-num">{i + 1}</span>
              <h3>{e.titre}</h3>
              <p>{e.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ========== Questions ========== -->
  <section class="section" aria-labelledby="titre-faq">
    <div class="conteneur faq-in">
      <div class="entete-section">
        <span class="surtitre">Questions fréquentes</span>
        <h2 class="titre-section" id="titre-faq">Vous vous demandez peut-être…</h2>
      </div>
      <div class="faq">
        {
          questions.map((x) => (
            <details>
              <summary>{x.q}</summary>
              <p>{x.r}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ========== Contact ========== -->
  <section class="section section-sombre" id="contact" aria-labelledby="titre-contact">
    <div class="conteneur contact-in">
      <div class="contact-texte">
        <span class="surtitre">Contact</span>
        <h2 class="titre-section" id="titre-contact">Parlons de votre site.</h2>
        <p class="intro-section">
          Décrivez-nous votre commerce en quelques mots : on vous répond sous 48 h et on passe vous
          voir pour en discuter. Le devis est gratuit.
        </p>
        <ul class="contact-directs" role="list">
          <li>
            <span>E-mail</span>
            <a href={`mailto:${studio.email}`}>{studio.email}</a>
          </li>
          <li>
            <span>Instagram</span>
            <a href={studio.instagram} target="_blank" rel="noopener">{studio.pseudo}</a>
          </li>
          <li>
            <span>TikTok</span>
            <a href={studio.tiktok} target="_blank" rel="noopener">{studio.pseudo}</a>
          </li>
          <li>
            <span>Zone</span>
            {studio.zone}
          </li>
        </ul>
      </div>
      <Formulaire />
    </div>
  </section>
</Layout>

<style>
  /* ---------- Accueil ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(circle at 12% 10%, rgba(32, 184, 168, 0.2), transparent 40%),
      radial-gradient(circle at 90% 85%, rgba(32, 184, 168, 0.12), transparent 40%),
      linear-gradient(160deg, var(--petrole) 0%, var(--petrole-2) 100%);
    color: var(--clair);
    padding-block: clamp(48px, 8vw, 104px) clamp(64px, 9vw, 120px);
  }
  .hero-in {
    display: grid;
    gap: 56px;
    align-items: center;
  }
  @media (min-width: 960px) {
    .hero-in {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  .pastille {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 10px;
    border: 1px solid rgba(32, 184, 168, 0.45);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--turquoise-clair);
    background: rgba(32, 184, 168, 0.08);
  }
  .pastille span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--turquoise);
    box-shadow: 0 0 0 4px rgba(32, 184, 168, 0.25);
  }
  .hero h1 {
    margin-top: 22px;
    font-size: clamp(2.3rem, 6vw, 3.9rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--turquoise);
  }
  .hero-intro {
    margin-top: 22px;
    max-width: 52ch;
    font-size: 1.15rem;
    color: var(--gris-clair);
  }
  .hero-actions {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero-preuves {
    list-style: none;
    margin: 40px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 14px 32px;
    color: var(--gris-clair);
    font-size: 0.95rem;
  }
  .hero-preuves strong {
    display: block;
    color: var(--blanc);
    font-size: 1.25rem;
    font-weight: 800;
  }

  .hero-visuel {
    position: relative;
    max-width: 560px;
    width: 100%;
    margin-inline: auto;
    padding-bottom: 40px;
  }
  .navigateur {
    border-radius: 14px;
    overflow: hidden;
    background: var(--blanc);
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.6);
    transform: perspective(1400px) rotateY(-6deg) rotateX(3deg);
  }
  .navigateur-barre {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    background: #e9eef0;
  }
  .navigateur-barre i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #c5d0d4;
  }
  .navigateur-barre span {
    margin-left: 10px;
    flex: 1;
    padding: 3px 10px;
    border-radius: 6px;
    background: var(--blanc);
    font-size: 0.75rem;
    color: var(--gris);
  }
  .navigateur :global(img) {
    width: 100%;
    height: auto;
  }
  .telephone {
    position: absolute;
    right: -6px;
    bottom: 0;
    width: 30%;
    min-width: 120px;
    aspect-ratio: 9 / 18;
    padding: 7px;
    border-radius: 22px;
    background: #0a1f28;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }
  .telephone-ecran {
    height: 100%;
    border-radius: 16px;
    background: var(--clair);
    padding: 14px 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tel-logo {
    width: 34%;
    height: 8px;
    border-radius: 4px;
    background: var(--petrole);
  }
  .tel-ligne {
    height: 7px;
    border-radius: 4px;
    background: #cbd8dc;
  }
  .tel-ligne.l1 {
    margin-top: 12px;
    width: 90%;
    height: 12px;
    background: var(--petrole);
  }
  .tel-ligne.l2 {
    width: 70%;
  }
  .tel-bouton {
    margin-top: 6px;
    padding: 6px;
    border-radius: 8px;
    background: var(--turquoise);
    color: var(--petrole);
    font-size: 0.7rem;
    font-weight: 800;
    text-align: center;
  }
  .tel-carte {
    flex: 1;
    border-radius: 8px;
    background:
      linear-gradient(90deg, transparent 48%, #d3dee1 48% 52%, transparent 52%),
      linear-gradient(0deg, transparent 46%, #d3dee1 46% 54%, transparent 54%),
      #e6eef0;
    position: relative;
  }
  .tel-carte::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 14px;
    border-radius: 50% 50% 50% 0;
    background: var(--turquoise);
    transform: translate(-50%, -70%) rotate(-45deg);
  }
  @media (max-width: 540px) {
    .telephone {
      right: -4px;
      min-width: 96px;
    }
  }

  /* ---------- Pour qui ---------- */
  .metiers {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .metiers {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1000px) {
    .metiers {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .metier {
    padding: 26px 22px;
    border: 1px solid var(--bord);
    border-radius: var(--rayon);
    background: var(--blanc);
  }
  .metier-icone {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: rgba(32, 184, 168, 0.12);
    color: var(--turquoise-fonce);
    margin-bottom: 18px;
  }
  .metier h3 {
    font-size: 1.2rem;
    font-weight: 800;
  }
  .metier p {
    margin-top: 6px;
    color: var(--gris);
  }

  /* ---------- Atouts ---------- */
  .atouts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    grid-template-columns: 1fr;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }
  @media (min-width: 760px) {
    .atouts {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 48px;
    }
  }
  .atout {
    padding: 28px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: grid;
    grid-template-columns: 56px 1fr;
    column-gap: 8px;
  }
  .atout-num {
    grid-row: span 2;
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--turquoise);
  }
  .atout h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--blanc);
  }
  .atout p {
    margin-top: 6px;
    color: var(--gris-clair);
  }

  /* ---------- Offres ---------- */
  .boutique-ligne {
    margin-top: 20px;
    text-align: center;
    color: var(--gris);
  }
  .boutique-ligne strong {
    color: var(--texte);
  }
  .maintenance {
    margin-top: 32px;
    padding: 28px;
    border-radius: var(--rayon);
    background: var(--fond);
    border: 1px solid var(--bord);
    display: grid;
    gap: 20px;
    align-items: center;
  }
  @media (min-width: 760px) {
    .maintenance {
      grid-template-columns: 240px 1fr;
      gap: 40px;
    }
  }
  .maintenance-prix .surtitre {
    margin-bottom: 4px;
  }
  .maintenance-prix p {
    font-size: 1.1rem;
  }
  .maintenance-prix strong {
    font-size: 2.4rem;
    font-weight: 800;
    letter-spacing: -0.03em;
  }
  .maintenance-prix small {
    color: var(--gris);
    font-size: 0.9rem;
  }
  .maintenance ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .maintenance li {
    position: relative;
    padding-left: 20px;
  }
  .maintenance li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--turquoise);
  }
  .offres-bas {
    margin-top: 28px;
    display: grid;
    gap: 18px;
    justify-items: center;
    text-align: center;
  }
  .lancement {
    width: 100%;
    padding: 16px 20px;
    border-radius: var(--rayon-petit);
    background: var(--turquoise);
    color: var(--petrole);
    font-weight: 800;
    font-size: 1.1rem;
  }
  .lien-fleche {
    font-weight: 600;
    color: var(--turquoise-fonce);
    text-underline-offset: 4px;
  }

  /* ---------- Méthode ---------- */
  .etapes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
    counter-reset: etape;
  }
  @media (min-width: 640px) {
    .etapes {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .etapes {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .etape {
    padding: 26px 22px;
    border-radius: var(--rayon);
    background: var(--blanc);
    border: 1px solid var(--bord);
  }
  .etape-num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--petrole);
    color: var(--turquoise);
    font-weight: 800;
    font-size: 1.15rem;
    margin-bottom: 16px;
  }
  .etape h3 {
    font-size: 1.2rem;
    font-weight: 800;
  }
  .etape p {
    margin-top: 6px;
    color: var(--gris);
  }

  /* ---------- FAQ ---------- */
  .faq-in {
    display: grid;
    gap: 0;
  }
  @media (min-width: 960px) {
    .faq-in {
      grid-template-columns: 1fr 1.4fr;
      gap: 56px;
    }
  }
  .faq {
    border-top: 1px solid var(--bord);
  }
  .faq details {
    border-bottom: 1px solid var(--bord);
  }
  .faq summary {
