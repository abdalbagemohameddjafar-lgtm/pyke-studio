---
// Page d'accueil de Pyke Studio — mise en page éditoriale.
// Textes des formules et offre de lancement : src/data/tarifs.ts — coordonnées : src/data/studio.ts.
import Layout from '../layouts/Layout.astro';
import Formulaire from '../components/Formulaire.astro';
import Telephone from '../components/Telephone.astro';
import { studio } from '../data/studio';
import RealisationsList from '../components/RealisationsList.astro';
import FeaturedDemo from '../components/FeaturedDemo.astro';
import FormuleExemple from '../components/FormuleExemple.astro';
import { formules, boutique, maintenance, offreLancement, prixRemise, euros } from '../data/tarifs';

const metiers = [
  { nom: 'Fleuristes', texte: 'Vos compositions en photos, vos horaires et la commande par téléphone.', formule: 'Vitrine' },
  { nom: 'Restaurants et cafés', texte: 'La carte toujours à jour, les horaires et la réservation en un geste.', formule: 'Vitrine+' },
  { nom: 'Salons de tatouage', texte: 'Un portfolio de vos flashs et une demande de rendez-vous simple.', formule: 'Vitrine' },
  { nom: 'Boutiques', texte: 'Vos produits, votre univers et l’adresse pour passer en magasin.', formule: 'Essentiel' },
];

const etapes = [
  { titre: 'Décrire votre commerce', texte: 'Un premier échange gratuit, puis un devis au prix affiché. 40 % d’acompte à la signature.' },
  { titre: 'Valider la maquette', texte: 'Vous relisez votre site avant sa sortie. Deux séries de corrections sont incluses.' },
  { titre: 'Mettre le site en ligne', texte: 'Le solde est réglé à la mise en ligne. Ensuite, la maintenance s’occupe du reste.' },
];

const questions = [
  {
    q: 'Je n’ai ni textes ni photos, c’est un problème ?',
    r: 'Non. Nous rédigeons vos textes (120 €) et nous vous envoyons un guide simple pour prendre de bonnes photos avec votre téléphone. Nous les retouchons ensuite pour le site.',
  },
  {
    q: 'Le nom de domaine et l’hébergement sont compris ?',
    r: `Oui, avec la maintenance à ${maintenance.prixMois} € par mois (${maintenance.engagement}), mises à jour et sauvegardes comprises.`,
  },
  { q: 'Je pourrai changer mes horaires ou mes prix ?', r: 'Oui. Envoyez-nous un message : 30 minutes de modifications par mois sont comprises dans la maintenance.' },
  { q: 'Vous travaillez dans quelle ville ?', r: 'Partout en France. Tout se fait à distance, par téléphone, visio ou e-mail.' },
  { q: 'Faut-il ajouter la TVA ?', r: 'Non. Pyke Studio est une micro-entreprise, TVA non applicable : vous payez le prix affiché.' },
];

const deux = (n: number) => String(n).padStart(2, '0');
/** 390 → « 390 » (le « € » est composé à part pour la typo des prix) */
const montant = (n: number) => euros(n).replace(/\s?€$/, '');
// Exemple affiché par défaut sous les formules : celui de la formule « Recommandé »
const formuleDefaut = formules.find((f) => f.vedette) ?? formules[0];
const rangDefaut = formules.indexOf(formuleDefaut);
// Numéro « d'édition », façon couverture de magazine : mois et année du dernier build
const edition = new Date().toLocaleDateString('fr-FR', { month: 'long', year: 'numeric' });
---

<Layout accueil>
  <!-- 00 · ACCUEIL -->
  <section class="hero" id="top" aria-labelledby="hero-h">
    <span class="deco deco--trame deco--haut-droite" aria-hidden="true"></span>
    <span class="deco deco--etoile" aria-hidden="true">✳</span>
    <!-- Tampon rond qui tourne lentement, comme un cachet d'imprimeur -->
    <span class="deco deco--tampon" aria-hidden="true">
      <svg viewBox="0 0 120 120">
        <defs><path id="tampon-cercle" d="M60 60m-47 0a47 47 0 1 1 94 0a47 47 0 1 1-94 0" /></defs>
        <g class="tampon__texte">
          <text><textPath href="#tampon-cercle" textLength="292" lengthAdjust="spacing">SITES FAITS MAIN · PARTOUT EN FRANCE · </textPath></text>
        </g>
        <circle cx="60" cy="60" r="33" />
        <text class="tampon__centre" x="60" y="60">N°01</text>
      </svg>
    </span>
    <span class="forme forme--demi c-brique f-hero-demi anim-flotte" aria-hidden="true"></span>
    <span class="forme forme--losange c-ocre f-hero-losange anim-oscille" aria-hidden="true"></span>
    <div class="wrap">
      <div class="hero__haut">
        <p class="label">Studio web · Partout en France</p>
        <p class="label hero__edition">N° 01 — <span class="edition-mois">{edition}</span></p>
        {offreLancement && <p class="label accent">{offreLancement}</p>}
      </div>
      <div class="grille">
        <h1 id="hero-h" data-reveal>Sites web pour artisans et commerçants</h1>
        <div class="hero__cote">
          <p class="chapo">Une page ou un site complet, pensé pour le mobile et trouvé sur Google. Dès 390&nbsp;€, en ligne 7 à 10&nbsp;jours après réception de vos contenus.</p>
          <div class="hero__actions">
            <a class="bouton" href="#devis">Demander un devis <span class="fleche" aria-hidden="true">→</span></a>
            <a class="lien" href="#formules">Voir les formules</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 · MÉTIERS -->
  <section class="section" id="metiers" aria-labelledby="metiers-h">
    <span class="deco deco--folio" aria-hidden="true">01</span>
    <span class="forme forme--pilule c-sauge f-metiers-pilule" aria-hidden="true"></span>
    <span class="deco deco--mire deco--mire-bas-droite" aria-hidden="true"></span>
    <div class="wrap">
      <div class="section__tete">
        <p class="section__num label">01 — Métiers</p>
        <h2 id="metiers-h" data-reveal>Des sites pour les commerces de proximité</h2>
        <p class="chapo">Chaque métier a ses besoins : votre site met en avant ce que vos clients cherchent.</p>
      </div>
      <ul class="tableau" role="list">
        {metiers.map((m, i) => (
          <li>
            <span class="t-num mono discret">{deux(i + 1)}</span>
            <span class="t-nom serif">{m.nom}</span>
            <span class="t-texte">{m.texte}</span>
            <span class="t-formule mono">{m.formule}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 02 · RÉALISATIONS : liste des démos (données : src/data/demos.ts) -->
  <section class="section realisations" id="realisations" aria-labelledby="realisations-h">
    <span class="deco deco--folio" aria-hidden="true">02</span>
    <span class="forme forme--rond c-ocre f-real-rond anim-flotte-lent" aria-hidden="true"></span>
    <span class="forme forme--triangle c-brique f-real-triangle anim-tourne" aria-hidden="true"></span>
    <div class="wrap">
      <p class="section__num label">02 — Réalisations</p>
      <h2 id="realisations-h" class="label realisations__surtitre">Nos sites de démonstration</h2>
      <RealisationsList />
      <div class="realisations__reperes mono discret" aria-hidden="true">
        <span>02</span>
        <span>Voir les démos</span>
      </div>
      <FeaturedDemo />
    </div>
  </section>

  <!-- 03 · MÉTHODE -->
  <section class="section" id="methode" aria-labelledby="methode-h">
    <span class="deco deco--folio" aria-hidden="true">03</span>
    <span class="forme forme--arc c-ardoise f-methode-arc anim-tourne-lent" aria-hidden="true"></span>
    <span class="deco deco--trame deco--trame-accent deco--bas-gauche" aria-hidden="true"></span>
    <div class="wrap">
      <div class="section__tete">
        <p class="section__num label">03 — Méthode</p>
        <h2 id="methode-h" data-reveal>Votre site en 3 étapes</h2>
        <p class="chapo">Tout se fait à distance, par téléphone, visio ou e-mail, où que vous soyez en France.</p>
      </div>
      <ol class="colonnes" role="list">
        {etapes.map((e, i) => (
          <li>
            <span class="etape-num" aria-hidden="true">{deux(i + 1)}</span>
            <h3>{e.titre}</h3>
            <p class="discret">{e.texte}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 04 · FORMULES -->
  <section class="section section--formules" id="formules" aria-labelledby="formules-h">
    <span class="deco deco--folio" aria-hidden="true">04</span>
    <span class="forme forme--demi c-rose f-formules-demi" aria-hidden="true"></span>
    <div class="wrap">
      <div class="section__tete">
        <p class="section__num label">04 — Formules</p>
        <h2 id="formules-h" data-reveal>Formules et prix</h2>
        <p class="chapo">Prix nets, TVA non applicable.</p>
      </div>
      <div class="formules">
        {formules.map((f, i) => {
          const remise = prixRemise(f.prix);
          return (
            <article class="formule" data-formule-carte={f.slug} data-choisie={f === formuleDefaut ? '' : undefined} style={`--ordre: ${i * 2}`}>
              <div class="formule__tete">
                <h3>{f.nom}</h3>
                {f.vedette && <span class="label accent">Recommandé</span>}
              </div>
              <p class="discret">{f.pourQui}</p>
              {remise !== null ? (
                <div class="prix-ligne">
                  <p class="prix"><span class="cache">Prix de lancement : </span>{montant(remise)}<small>€</small></p>
                  <p class="prix-avant mono"><span class="cache">au lieu de </span><s>{euros(f.prix)}</s></p>
                </div>
              ) : (
                <p class="prix">{montant(f.prix)}<small>€</small></p>
              )}
              <div class="points">
                {f.inclut && <p class="label">{f.inclut}</p>}
                <ul role="list">
                  {f.points.map((x) => <li>{x}</li>)}
                </ul>
              </div>
              <div class="formule__actions">
                <a class="bouton" href={`?formule=${f.slug}#devis`} data-formule={f.nom}>Choisir cette formule <span class="fleche" aria-hidden="true">→</span></a>
                <button class="formule__exemple-btn mono" type="button" data-exemple-choix={f.slug} aria-pressed={f === formuleDefaut ? 'true' : 'false'} aria-controls="formule-exemple">
                  Voir l’exemple<span class="cache"> de la formule {f.nom}</span>
                </button>
              </div>
            </article>
          );
        })}
        <!-- Exemple de site : celui de la formule choisie (par défaut « Recommandé ») -->
        <div class="formules__exemple" id="formule-exemple" aria-live="polite" style={`--ordre-mobile: ${rangDefaut * 2 + 1}`}>
          <FormuleExemple slug={formuleDefaut.slug} />
        </div>
        {formules.map((f) => (
          <template data-exemple={f.slug}><FormuleExemple slug={f.slug} /></template>
        ))}
      </div>
      <div class="offres-plus">
        <p>
          {offreLancement && <>{offreLancement} (prix barré = prix normal). </>}
          {boutique.nom} sur devis, dès {euros(boutique.aPartirDe)}. Maintenance {maintenance.prixMois} € par mois avec {maintenance.engagement} : hébergement, nom de domaine et modifications.
        </p>
        <a class="lien" href="/tarifs">Voir tous les tarifs <span class="fleche" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 05 · QUESTIONS -->
  <section class="section" id="questions" aria-labelledby="questions-h">
    <span class="deco deco--folio" aria-hidden="true">05</span>
    <span class="forme forme--vague c-brique f-questions-vague anim-oscille" aria-hidden="true"></span>
    <span class="deco deco--trame deco--milieu-droite" aria-hidden="true"></span>
    <div class="wrap">
      <div class="section__tete">
        <p class="section__num label">05 — Questions</p>
        <h2 id="questions-h" data-reveal>Questions fréquentes</h2>
        <p class="chapo">Une autre question&#8239;? <a class="lien" href="#devis">Écrivez-nous</a>, nous répondons sous 48&nbsp;h.</p>
      </div>
      <div class="grille">
        <div class="faq">
          {questions.map((x, i) => (
            <details open={i === 0}>
              <summary>{x.q}<span class="plus" aria-hidden="true"></span></summary>
              <p>{x.r}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 06 · DEVIS -->
  <section class="section" id="devis" aria-labelledby="devis-h">
    <span class="deco deco--folio deco--folio-bas" aria-hidden="true">06</span>
    <span class="forme forme--rond c-ardoise f-devis-rond anim-flotte" aria-hidden="true"></span>
    <span class="deco deco--mire deco--mire-gauche" aria-hidden="true"></span>
    <span class="deco deco--nuancier" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
    <div class="wrap">
      <div class="grille">
        <div class="devis-texte">
          <p class="label">06 — Devis</p>
          <h2 id="devis-h" data-reveal>Demander un devis</h2>
          <p class="chapo">Décrivez votre commerce en quelques lignes. Le devis est gratuit, la réponse arrive sous 48&nbsp;h.</p>
          <ul class="contacts" role="list">
            <li><span class="label">E-mail</span><a class="lien" href={`mailto:${studio.email}`}>{studio.email}</a></li>
            <li><span class="label">Téléphone</span><Telephone /></li>
          </ul>
        </div>
        <div class="devis-form">
          <Formulaire />
        </div>
      </div>
    </div>
  </section>
</Layout>
