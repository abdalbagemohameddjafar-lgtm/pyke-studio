---
// Gabarit commun à toutes les pages : en-tête, pied de page, polices, styles.
// Design : src/styles/site.css (éditorial, papier chaud / encre / accent brique).
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/inter-tight/wght.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/site.css';
import Logo from '../components/Logo.astro';
import Telephone from '../components/Telephone.astro';
import Email from '../components/Email.astro';
import { studio } from '../data/studio';

interface Props {
  titre?: string;
  description?: string;
  /** true sur l'accueil : liens d'ancre courts (#formules) ; false ailleurs (/#formules). */
  accueil?: boolean;
  /** true : la page n'est pas indexée par les moteurs de recherche (merci, 404). */
  noindex?: boolean;
}

const {
  titre = 'Pyke Studio · Sites web pour artisans et commerçants',
  description = 'Pyke Studio crée des sites web pour les artisans et commerçants de toute la France : fleuristes, restaurants, tatoueurs, boutiques. Dès 390 €, en ligne en 7 à 10 jours.',
  accueil = false,
  noindex = false,
} = Astro.props;

const base = accueil ? '' : '/';
const canonique = new URL(Astro.url.pathname, Astro.site);
const annee = new Date().getFullYear();

const liens = [
  { href: `${base}#metiers`, texte: 'Métiers' },
  { href: `${base}#realisations`, texte: 'Réalisations' },
  { href: `${base}#methode`, texte: 'Méthode' },
  { href: `${base}#formules`, texte: 'Formules' },
  { href: `${base}#questions`, texte: 'Questions' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: studio.nom,
  description,
  url: studio.url,
  email: studio.email,
  ...(studio.telephone && { telephone: studio.telephone.lien }),
  areaServed: { '@type': 'Country', name: 'France' },
  sameAs: [studio.instagram, studio.tiktok],
  priceRange: '390 € – 1 500 €+',
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f4f1ea" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={new URL('/og-pyke-studio.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Pyke Studio, sites web pour artisans et commerçants" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="cache evitement" href="#contenu">Aller au contenu</a>

    <!-- Les lignes de la grille 12 colonnes, en fond -->
    <div class="lignes" aria-hidden="true">
      <div class="wrap"><div class="grille"><span></span><span></span><span></span><span></span></div></div>
    </div>

    <header class="entete">
      <div class="wrap">
        <a class="entete__logo" href={accueil ? '#top' : '/'} aria-label="Pyke Studio, accueil"><Logo /></a>
        <nav class="entete__liens" id="menu" aria-label="Menu principal">
          {liens.map((l) => <a href={l.href}>{l.texte}</a>)}
        </nav>
        <a class="bouton" href={`${base}#devis`}>Demander un devis</a>
        <button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Ouvrir le menu">
          <span></span><span></span>
        </button>
      </div>
    </header>

    <main id="contenu">
      <slot />
    </main>

    <footer class="pied" id="contact">
      <div class="wrap">
        <div class="pied__appel">
          <h2 data-reveal>Parlons de votre commerce</h2>
          <div class="pied__cote">
            <p class="discret">Devis gratuit, réponse sous 48 h.</p>
            <a class="bouton bouton--clair" href={`${base}#devis`}>Demander un devis <span class="fleche" aria-hidden="true">→</span></a>
          </div>
        </div>

        <div class="pied__liens">
          <div>
            <p class="label">Le studio</p>
            <a href={`${base}#metiers`}>Métiers</a>
            <a href={`${base}#realisations`}>Réalisations</a>
            <a href={`${base}#methode`}>Méthode</a>
          </div>
          <div>
            <p class="label">Formules</p>
            <a href={`${base}#formules`}>Formules et prix</a>
            <a href="/tarifs">Tarifs détaillés</a>
            <a href={`${base}#questions`}>Questions</a>
          </div>
          <div>
            <p class="label">Contact</p>
            <Email />
            <a href={studio.instagram} rel="noopener">Instagram</a>
            <a href={studio.tiktok} rel="noopener">TikTok</a>
            <Telephone />
          </div>
          <div>
            <p class="label">Légal</p>
            <a href="/mentions-legales">Mentions légales</a>
            <a href="/mentions-legales#donnees">Données personnelles</a>
            <a href="/cgv">CGV</a>
            <a href="/retractation">Rétractation</a>
          </div>
        </div>

        <p class="pied__nom" aria-hidden="true">Pyke Studio</p>

        <div class="pied__legal mono discret">
          <span>© {annee} {studio.nom} — {studio.legal.responsableCourt} · {studio.legal.tva}</span>
          <span><span aria-hidden="true">· </span>{studio.slogan}, partout en France, à distance.</span>
        </div>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
