---
// Mise en page des pages de texte (tarifs détaillés, mentions légales, CGV, merci, 404).
import Layout from './Layout.astro';

interface Props {
  titre: string;
  h1: string;
  description?: string;
  noindex?: boolean;
}
const { titre, h1, description, noindex = false } = Astro.props;
---

<Layout titre={titre} description={description} noindex={noindex}>
  <div class="page-texte">
    <div class="wrap">
      <div class="contenu">
        <h1>{h1}</h1>
        <slot />
      </div>
    </div>
  </div>
</Layout>
